        "placement": ["menubar.tools", "newTabDropdown"]
      },
      {
        "command": "table-access",
        "name": "Who Can Access This?",
        "view": "user-management",
        "placement": "entity.table.context"
      },
      {
        "command": "schema-access",
        "name": "Who Can Access This?",
        "view": "user-management",
        "placement": "entity.schema.context"
      }
